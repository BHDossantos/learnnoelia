NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
NEXT_PUBLIC_LIVEKIT_URL=

# Web push (streak reminders): generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret protecting the reminder cron endpoint (any long random string)
CRON_SECRET=

# Canonical site URL (used for OG/canonical/sitemap)
NEXT_PUBLIC_SITE_URL=https://learnnoelia.com

# Comma-separated emails allowed to view /admin (metrics dashboard)
ADMIN_EMAILS=

# Set to 1 AFTER enabling the Google provider in Supabase (Auth -> Providers)
NEXT_PUBLIC_GOOGLE_AUTH=

# Email delivery for graded-paper feedback (teacher "email student/parent" button).
# Without RESEND_API_KEY the button falls back to opening the teacher's own mail
# client. Get a key at resend.com; EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM="Noelia <feedback@learnnoelia.com>"

# Business agent (ported from Jennifer). Off unless true; admins (ADMIN_EMAILS) run it at /api/admin/business-agent.
BUSINESS_AGENT_ENABLED=
# Optional model override for the business agent.
BUSINESS_AGENT_MODEL=
